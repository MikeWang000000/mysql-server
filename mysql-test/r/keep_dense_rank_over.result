#
# Oracle-compatible KEEP (...) OVER () / OVER (PARTITION BY ...)
#
CREATE TABLE t (a INT, b INT, c INT, d INT);
INSERT INTO t VALUES
(1, 10, 1, 1),
(1, 20, 2, 1),
(1, 30, 2, 2),
(2, 40, 1, 1),
(2, 50, NULL, 2),
(3, NULL, 3, 1),
(3, 60, 3, 2),
(4, 70, NULL, 1);
# Basic window form: value is constant within each partition
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t ORDER BY a, b;
a	b	s
1	10	10
1	20	10
1	30	10
2	40	50
2	50	50
3	NULL	60
3	60	60
4	70	70
# OVER () treats the whole result set as one partition
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER () AS s
FROM t ORDER BY a, b;
a	b	s
1	10	120
1	20	120
1	30	120
2	40	120
2	50	120
3	NULL	120
3	60	120
4	70	120
# DENSE_RANK LAST
SELECT a, b, SUM(b) KEEP (DENSE_RANK LAST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t ORDER BY a, b;
a	b	s
1	10	50
1	20	50
1	30	50
2	40	40
2	50	40
3	NULL	60
3	60	60
4	70	70
# All supported aggregate functions
SELECT a,
MIN(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS mn,
MAX(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS mx,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS sm,
AVG(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS av,
COUNT(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a)
AS cnt,
COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a)
AS cnt_star
FROM t ORDER BY a;
a	mn	mx	sm	av	cnt	cnt_star
1	10	10	10	10.0000	1	1
1	10	10	10	10.0000	1	1
1	10	10	10	10.0000	1	1
2	50	50	50	50.0000	1	1
2	50	50	50	50.0000	1	1
3	60	60	60	60.0000	1	2
3	60	60	60	60.0000	1	2
4	70	70	70	70.0000	1	1
# STDDEV/VARIANCE use MySQL (population) semantics in window form
SELECT a, b,
STDDEV(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS sd_first,
STDDEV(b) KEEP (DENSE_RANK LAST ORDER BY c)
OVER (PARTITION BY a) AS sd_last
FROM t ORDER BY a, b;
a	b	sd_first	sd_last
1	10	0	5
1	20	0	5
1	30	0	5
2	40	0	0
2	50	0	0
3	NULL	0	0
3	60	0	0
4	70	0	0
# MySQL population semantics: one value -> 0, none -> NULL
CREATE TABLE tv (a INT, b INT, c INT);
INSERT INTO tv VALUES
(1, NULL, 1), (1, 10, 2),
(2, 10, 1), (2, 20, 2),
(3, 10, 1), (3, 20, 1), (3, 40, 2);
SELECT a,
STDDEV(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS sd,
VARIANCE(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS var
FROM tv ORDER BY a;
a	sd	var
1	NULL	NULL
1	NULL	NULL
2	0	0
2	0	0
3	5	25
3	5	25
3	5	25
DROP TABLE tv;
# Multiple partition columns
SELECT a, d, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a, d) AS s
FROM t ORDER BY a, d, b;
a	d	s
1	1	10
1	1	10
1	2	30
2	1	40
2	2	50
3	1	NULL
3	2	60
4	1	70
# STRING/DECIMAL/DATE result types through the window path
CREATE TABLE tm (g INT, s VARCHAR(10) COLLATE utf8mb4_bin,
x DECIMAL(10, 2), d DATE, v INT);
INSERT INTO tm VALUES
(1, 'b', 2.50, '2020-01-03', 20),
(1, 'a', 1.25, '2020-01-01', 10),
(1, 'c', 3.75, '2020-01-02', 30);
SELECT g,
MIN(s) KEEP (DENSE_RANK FIRST ORDER BY v)
OVER (PARTITION BY g) AS ms,
AVG(x) KEEP (DENSE_RANK FIRST ORDER BY v)
OVER (PARTITION BY g) AS ax,
MIN(d) KEEP (DENSE_RANK FIRST ORDER BY v)
OVER (PARTITION BY g) AS md
FROM tm ORDER BY g, v;
g	ms	ax	md
1	a	1.250000	2020-01-01
1	a	1.250000	2020-01-01
1	a	1.250000	2020-01-01
DROP TABLE tm;
# JSON result type through the window path
CREATE TABLE tj (g INT, j JSON, v INT);
INSERT INTO tj VALUES
(1, '{"k": 2}', 20), (1, '{"k": 1}', 10), (1, '{"k": 3}', 30);
SELECT g, MIN(j) KEEP (DENSE_RANK FIRST ORDER BY v)
OVER (PARTITION BY g) AS mj_first,
MAX(j) KEEP (DENSE_RANK LAST ORDER BY v)
OVER (PARTITION BY g) AS mj_last
FROM tj;
g	mj_first	mj_last
1	{"k": 1}	{"k": 3}
1	{"k": 1}	{"k": 3}
1	{"k": 1}	{"k": 3}
DROP TABLE tj;
# Constant ORDER BY expressions: all rows in a partition are peers
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY 1) OVER (PARTITION BY a) AS s
FROM t ORDER BY a;
a	s
1	60
1	60
1	60
2	90
2	90
3	60
3	60
4	70
SELECT a, COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY NULL)
OVER (PARTITION BY a) AS c
FROM t ORDER BY a;
a	c
1	3
1	3
1	3
2	2
2	2
3	2
3	2
4	1
# Single-row partition
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t WHERE a = 4;
a	b	s
4	70	70
# Input rows not sorted by partition
CREATE TABLE ts (a INT, b INT, c INT);
INSERT INTO ts VALUES
(2, 50, NULL), (1, 20, 2), (3, 60, 3), (1, 10, 1),
(2, 40, 1), (3, NULL, 3), (1, 30, 2), (4, 70, NULL);
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM ts ORDER BY a, b;
a	b	s
1	10	10
1	20	10
1	30	10
2	40	50
2	50	50
3	NULL	60
3	60	60
4	70	70
DROP TABLE ts;
# Multiple ORDER BY columns, DESC and explicit NULL placement
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c, d DESC)
OVER (PARTITION BY a) AS s1,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c DESC NULLS LAST)
OVER (PARTITION BY a) AS s2
FROM t ORDER BY a;
a	s1	s2
1	10	50
1	10	50
1	10	50
2	50	40
2	50	40
3	60	60
3	60	60
4	70	70
# Multiple KEEPs in one SELECT list: different FIRST/LAST/NULLS
SELECT a, b,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS FIRST)
OVER (PARTITION BY a) AS f_nf,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST)
OVER (PARTITION BY a) AS f_nl,
SUM(b) KEEP (DENSE_RANK LAST ORDER BY c NULLS FIRST)
OVER (PARTITION BY a) AS l_nf,
SUM(b) KEEP (DENSE_RANK LAST ORDER BY c NULLS LAST)
OVER (PARTITION BY a) AS l_nl,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY d DESC, c ASC NULLS FIRST)
OVER (PARTITION BY a) AS f_dc,
SUM(b) KEEP (DENSE_RANK LAST ORDER BY d ASC, c DESC NULLS LAST)
OVER (PARTITION BY a) AS l_dc
FROM t ORDER BY a, b;
a	b	f_nf	f_nl	l_nf	l_nl	f_dc	l_dc
1	10	10	10	50	50	30	30
1	20	10	10	50	50	30	30
1	30	10	10	50	50	30	30
2	40	50	40	40	50	50	50
2	50	50	40	40	50	50	50
3	NULL	60	60	60	60	60	60
3	60	60	60	60	60	60	60
4	70	70	70	70	70	70	70
# Two different window definitions in one query
SELECT a, d, b,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s1,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a, d) AS s2
FROM t ORDER BY a, d, b;
a	d	b	s1	s2
1	1	10	10	10
1	1	20	10	10
1	2	30	10	30
2	1	40	50	40
2	2	50	50	50
3	1	NULL	60	NULL
3	2	60	60	60
4	1	70	70	70
# KEEP window after another window function
SELECT a, b,
ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) AS rn,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t ORDER BY a, b;
a	b	rn	s
1	10	1	10
1	20	2	10
1	30	3	10
2	40	1	50
2	50	2	50
3	NULL	1	60
3	60	2	60
4	70	1	70
# Empty input
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER () AS s
FROM t WHERE 1 = 0;
s
# KEEP window expression inside another expression
SELECT a, ROUND(AVG(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a), 2) + 1 AS av
FROM t ORDER BY a;
a	av
1	11.00
1	11.00
1	11.00
2	51.00
2	51.00
3	61.00
3	61.00
4	71.00
# Query-level ORDER BY / LIMIT
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t ORDER BY s DESC, a, b LIMIT 5;
a	b	s
4	70	70
3	NULL	60
3	60	60
2	40	50
2	50	50
# KEEP window function used only in ORDER BY and with DISTINCT
SELECT DISTINCT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t ORDER BY a;
a	s
1	10
2	50
3	60
4	70
# Derived table, scalar subquery, UNION ALL
SELECT * FROM (
SELECT a, MAX(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS x
FROM t
) dt ORDER BY a;
a	x
1	10
1	10
1	10
2	50
2	50
3	60
3	60
4	70
SELECT (SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER ()
FROM t WHERE a = 1 LIMIT 1) AS s;
s
10
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t WHERE a <= 2
UNION ALL
SELECT a, SUM(b) KEEP (DENSE_RANK LAST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t WHERE a >= 3
ORDER BY a, s;
a	s
1	10
1	10
1	10
2	50
2	50
3	60
3	60
4	70
# Prepared statement, executed twice
PREPARE stmt FROM
'SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
          OVER (PARTITION BY a) AS s
   FROM t ORDER BY a, b';
EXECUTE stmt;
a	b	s
1	10	10
1	20	10
1	30	10
2	40	50
2	50	50
3	NULL	60
3	60	60
4	70	70
EXECUTE stmt;
a	b	s
1	10	10
1	20	10
1	30	10
2	40	50
2	50	50
3	NULL	60
3	60	60
4	70	70
DEALLOCATE PREPARE stmt;
# Correlated subquery with a window KEEP, executed once per outer row
CREATE TABLE t2 (a INT);
INSERT INTO t2 VALUES (1), (2), (3), (4);
SELECT t2.a,
(SELECT SUM(t.b) KEEP (DENSE_RANK FIRST ORDER BY t.c) OVER ()
FROM t WHERE t.a = t2.a LIMIT 1) AS s
FROM t2 ORDER BY t2.a;
a	s
1	10
2	50
3	60
4	70
DROP TABLE t2;
# View definition round-trip (print())
CREATE VIEW vkeep_over AS
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t;
SELECT * FROM vkeep_over ORDER BY a, b;
a	b	s
1	10	10
1	20	10
1	30	10
2	40	50
2	50	50
3	NULL	60
3	60	60
4	70	70
SHOW CREATE VIEW vkeep_over;
View	Create View	character_set_client	collation_connection
vkeep_over	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `vkeep_over` AS select `t`.`a` AS `a`,`t`.`b` AS `b`,sum(`t`.`b`) KEEP (DENSE_RANK FIRST ORDER BY `t`.`c`) OVER (PARTITION BY `t`.`a` )  AS `s` from `t`	utf8mb4	utf8mb4_0900_ai_ci
DROP VIEW vkeep_over;
# CREATE TABLE ... SELECT
CREATE TABLE tctas AS
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t;
SELECT * FROM tctas ORDER BY a, b;
a	b	s
1	10	10
1	20	10
1	30	10
2	40	50
2	50	50
3	NULL	60
3	60	60
4	70	70
SHOW CREATE TABLE tctas;
Table	Create Table
tctas	CREATE TABLE `tctas` (
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL,
  `s` decimal(32,0) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE tctas;
# Same-level GROUP BY: grouped columns are legal
SELECT a, b, c, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t GROUP BY a, b, c ORDER BY a, b, c;
a	b	c	s
1	10	1	10
1	20	2	10
1	30	2	10
2	40	1	50
2	50	NULL	50
3	NULL	3	60
3	60	3	60
4	70	NULL	70
# Same-level GROUP BY: aggregate arguments are legal
SELECT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a ORDER BY a;
a	s
1	60
2	90
3	60
4	70
SELECT SQL_BIG_RESULT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a ORDER BY a;
a	s
1	60
2	90
3	60
4	70
SELECT a, SUM(a) KEEP (DENSE_RANK FIRST ORDER BY a)
OVER (PARTITION BY a) AS s
FROM t GROUP BY a ORDER BY a;
a	s
1	1
2	2
3	3
4	4
SELECT a, SUM(a) KEEP (DENSE_RANK FIRST ORDER BY a) OVER () AS s
FROM t GROUP BY a ORDER BY a;
a	s
1	1
2	1
3	1
4	1
PREPARE stmt2 FROM
'SELECT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
          OVER (PARTITION BY a) AS s
   FROM t GROUP BY a ORDER BY a';
EXECUTE stmt2;
a	s
1	60
2	90
3	60
4	70
EXECUTE stmt2;
a	s
1	60
2	90
3	60
4	70
DEALLOCATE PREPARE stmt2;
# Same-level GROUP BY: ungrouped references are rejected like MySQL
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t GROUP BY a;
ERROR 42000: Expression #2 of SELECT list is not in GROUP BY clause and contains nonaggregated column 'test.t.b' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by
SELECT a, COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t GROUP BY a;
ERROR 42000: Expression #2 of SELECT list is not in GROUP BY clause and contains nonaggregated column 'test.t.c' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by
# GROUP BY ... WITH ROLLUP, using aggregate arguments
SELECT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a WITH ROLLUP ORDER BY a;
a	s
NULL	280
1	60
2	90
3	60
4	70
