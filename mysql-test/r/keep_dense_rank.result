# MySQL population stddev/variance spellings are accepted
SELECT STD(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST) AS std_keep,
STDDEV_POP(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST)
AS stddev_pop_keep,
VAR_POP(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST)
AS var_pop_keep
FROM t;
std_keep	stddev_pop_keep	var_pop_keep
15	15	225
