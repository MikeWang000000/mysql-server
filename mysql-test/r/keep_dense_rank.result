#
# Oracle-compatible KEEP (DENSE_RANK FIRST|LAST ORDER BY ...)
#
CREATE TABLE t (a INT, b INT, c INT, d INT);
INSERT INTO t VALUES
(1, 10, 1, 1),
(1, 20, 2, 1),
(1, 30, 2, 2),
(2, 40, 1, 1),
(2, 50, NULL, 2),
(3, NULL, 3, 1),
(3, 60, 3, 2),
(4, 70, NULL, 1);
# Basic FIRST/LAST
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t;
s
120
SELECT SUM(b) KEEP (DENSE_RANK LAST ORDER BY c) AS s FROM t;
s
60
# Default NULL ordering in MySQL native mode: ASC => NULLS FIRST
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t;
s
120
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c DESC) AS s FROM t;
s
60
# Explicit NULLS FIRST/LAST
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS FIRST) AS s FROM t;
s
120
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c DESC NULLS LAST) AS s FROM t;
s
60
SELECT SUM(b) KEEP (DENSE_RANK LAST ORDER BY c DESC NULLS LAST) AS s FROM t;
s
120
# Peer rows all contribute to the aggregate
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY a) AS s FROM t WHERE a = 1;
s
60
SELECT COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY a) AS s FROM t WHERE a = 1;
s
3
SELECT COUNT(b) KEEP (DENSE_RANK FIRST ORDER BY a) AS s FROM t WHERE a = 1;
s
3
# Multiple ORDER BY columns
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c, d DESC) AS s FROM t;
s
50
SELECT SUM(b) KEEP (DENSE_RANK LAST ORDER BY c, d DESC) AS s FROM t;
s
NULL
# Multiple KEEPs in one SELECT list: different ORDER BY/FIRST/LAST/NULLS
SELECT a,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS FIRST) AS f_nf,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST) AS f_nl,
SUM(b) KEEP (DENSE_RANK LAST ORDER BY c NULLS FIRST) AS l_nf,
SUM(b) KEEP (DENSE_RANK LAST ORDER BY c NULLS LAST) AS l_nl,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY d DESC, c ASC NULLS FIRST)
AS f_dc,
SUM(b) KEEP (DENSE_RANK LAST ORDER BY d ASC, c DESC NULLS LAST)
AS l_dc
FROM t GROUP BY a ORDER BY a;
a	f_nf	f_nl	l_nf	l_nl	f_dc	l_dc
1	10	10	50	50	30	30
2	50	40	40	50	50	50
3	60	60	60	60	60	60
4	70	70	70	70	70	70
# All supported aggregate functions
SELECT
MIN(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS mn,
MAX(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS mx,
SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS sm,
AVG(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS av,
COUNT(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS cnt,
COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY c) AS cnt_star
FROM t;
mn	mx	sm	av	cnt	cnt_star
50	70	120	60.0000	2	2
# STDDEV/VARIANCE use MySQL (population) semantics inside KEEP
SELECT ROUND(STDDEV(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST), 6) AS sd,
VARIANCE(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST) = 225 AS var_ok
FROM t;
sd	var_ok
15	1
# MySQL population semantics: one value -> 0, none -> NULL
CREATE TABLE tv (a INT, b INT, c INT);
INSERT INTO tv VALUES
(1, NULL, 1), (1, 10, 2),
(2, 10, 1), (2, 20, 2),
(3, 10, 1), (3, 20, 1), (3, 40, 2);
SELECT a, STDDEV(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS sd,
VARIANCE(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS var
FROM tv GROUP BY a ORDER BY a;
a	sd	var
1	NULL	NULL
2	0	0
3	5	25
DROP TABLE tv;
# Ordinary MySQL functions keep their population semantics
SELECT STDDEV(b) = 20 AS ordinary_stddev_ok,
VARIANCE(b) = 400 AS ordinary_variance_ok
FROM t;
ordinary_stddev_ok	ordinary_variance_ok
1	1
# GROUP BY
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
FROM t GROUP BY a ORDER BY a;
a	s
1	10
2	50
3	60
4	70
# GROUP BY with SQL_BIG_RESULT
SELECT SQL_BIG_RESULT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
FROM t GROUP BY a ORDER BY a;
a	s
1	10
2	50
3	60
4	70
# HAVING / ORDER BY / LIMIT
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
FROM t GROUP BY a
HAVING s > 40
ORDER BY s DESC
LIMIT 2;
a	s
4	70
3	60
# Empty input
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t WHERE 1 = 0;
s
NULL
SELECT COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t WHERE 1 = 0;
s
0
SELECT COUNT(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t WHERE 1 = 0;
s
0
# Derived table and subquery
SELECT * FROM (
SELECT a, MAX(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS x
FROM t GROUP BY a
) dt ORDER BY a;
a	x
1	10
2	50
3	60
4	70
SELECT a FROM t
WHERE b = (SELECT MAX(b) KEEP (DENSE_RANK FIRST ORDER BY c) FROM t WHERE a = 1);
a
1
# Prepared statement, executed twice
PREPARE stmt FROM
'SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
   FROM t GROUP BY a ORDER BY a';
EXECUTE stmt;
a	s
1	10
2	50
3	60
4	70
EXECUTE stmt;
a	s
1	10
2	50
3	60
4	70
DEALLOCATE PREPARE stmt;
# ORDER BY expression and argument overlap
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY b) AS s FROM t;
s
NULL
SELECT SUM(c) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t;
s
NULL
SELECT SUM(b) KEEP (DENSE_RANK LAST ORDER BY -c) AS s FROM t;
s
50
# String and temporal ORDER BY values
CREATE TABLE tstr (g INT, s VARCHAR(10) COLLATE utf8mb4_bin, v INT);
INSERT INTO tstr VALUES
(1, 'b', 20), (1, 'a', 10), (1, 'c', 30), (1, 'a', 40);
SELECT SUM(v) KEEP (DENSE_RANK FIRST ORDER BY s) AS s FROM tstr;
s
50
SELECT SUM(v) KEEP (DENSE_RANK FIRST ORDER BY s DESC) AS s FROM tstr;
s
30
SELECT SUM(v) KEEP (DENSE_RANK LAST ORDER BY s DESC) AS s FROM tstr;
s
50
DROP TABLE tstr;
CREATE TABLE td (g INT, d DATE, v INT);
INSERT INTO td VALUES
(1, '2020-01-03', 30), (1, '2020-01-01', 10), (1, '2020-01-02', 20),
(2, '2020-02-01', 40), (2, '2020-02-02', 50);
SELECT MIN(d) KEEP (DENSE_RANK FIRST ORDER BY v) AS d1 FROM td;
d1
2020-01-01
SELECT g, MAX(d) KEEP (DENSE_RANK LAST ORDER BY v) AS d2
FROM td GROUP BY g ORDER BY g;
g	d2
1	2020-01-03
2	2020-02-02
DROP TABLE td;
CREATE TABLE tdec (g INT, x DECIMAL(10, 2), v INT);
INSERT INTO tdec VALUES
(1, 2.50, 20), (1, 1.25, 10), (1, 3.75, 30);
SELECT SUM(v) KEEP (DENSE_RANK FIRST ORDER BY x) AS s FROM tdec;
s
10
SELECT SUM(v) KEEP (DENSE_RANK LAST ORDER BY x DESC) AS s FROM tdec;
s
10
DROP TABLE tdec;
# View definition round-trip (print())
CREATE VIEW vkeep AS
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
FROM t GROUP BY a;
SELECT * FROM vkeep ORDER BY a;
a	s
1	10
2	50
3	60
4	70
SHOW CREATE VIEW vkeep;
View	Create View	character_set_client	collation_connection
vkeep	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `vkeep` AS select `t`.`a` AS `a`,sum(`t`.`b`) KEEP (DENSE_RANK FIRST ORDER BY `t`.`c`) AS `s` from `t` group by `t`.`a`	utf8mb4	utf8mb4_0900_ai_ci
DROP VIEW vkeep;
# KEEP in HAVING and ORDER BY
SELECT a FROM t GROUP BY a
HAVING SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) > 40
ORDER BY a;
a
2
3
4
SELECT a FROM t GROUP BY a
ORDER BY SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) DESC;
a
4
3
2
1
# Nested aggregates are rejected
SELECT SUM(SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)) FROM t;
ERROR HY000: Invalid use of group function
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY SUM(b)) FROM t;
ERROR HY000: Invalid use of group function
# UNION ALL materialization
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t
UNION ALL
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t WHERE a = 1;
s
120
10
# GROUP BY using an ordered index
ALTER TABLE t ADD INDEX idx_a (a);
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
FROM t GROUP BY a ORDER BY a;
a	s
1	10
2	50
3	60
4	70
ALTER TABLE t DROP INDEX idx_a;
# Constant ORDER BY expressions: all rows are peers
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY 1) AS s FROM t;
s
280
SELECT COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY 1) AS s FROM t;
s
8
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY NULL) AS s FROM t;
s
280
# CREATE TABLE ... SELECT uses create_tmp_field()
CREATE TABLE tctas AS
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s FROM t;
SELECT * FROM tctas;
s
120
SHOW CREATE TABLE tctas;
Table	Create Table
tctas	CREATE TABLE `tctas` (
  `s` decimal(32,0) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE tctas;
# Unaliased output names
SELECT COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY a) FROM t;
COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY a)
3
SELECT COUNT(b) KEEP (DENSE_RANK FIRST ORDER BY a) FROM t;
COUNT(b) KEEP (DENSE_RANK FIRST ORDER BY a)
3
# KEEP is a reserved word in this implementation
SELECT 1 AS keep;
