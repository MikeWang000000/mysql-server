1	NULL	190
1	1	190
1	2	190
2	NULL	190
2	1	190
2	2	190
3	NULL	190
3	1	190
3	2	190
4	NULL	190
4	1	190
# GROUPING() is allowed inside window KEEP arguments
SELECT a, d,
SUM(GROUPING(a)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a, d WITH ROLLUP ORDER BY a, d;
a	d	s
NULL	NULL	1
1	NULL	0
1	1	0
1	2	0
2	NULL	0
2	1	0
2	2	0
3	NULL	0
3	1	0
3	2	0
4	NULL	0
4	1	0
SELECT a, d,
SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY GROUPING(a))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a, d WITH ROLLUP ORDER BY a, d;
a	d	s
NULL	NULL	280
1	NULL	120
1	1	120
1	2	120
2	NULL	180
2	1	180
2	2	180
3	NULL	120
3	1	120
3	2	120
