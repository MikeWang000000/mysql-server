# Window KEEP together with another window function
SELECT a, d,
ROW_NUMBER() OVER (PARTITION BY a ORDER BY d) AS rn,
SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a, d WITH ROLLUP ORDER BY a, d;
a	d	rn	s
NULL	NULL	1	280
1	NULL	1	120
1	1	2	120
1	2	3	120
2	NULL	1	50
2	1	2	50
2	2	3	50
3	NULL	1	120
3	1	2	120
3	2	3	120
4	NULL	1	140
4	1	2	140
# Window KEEP prepared twice, view and CTAS
PREPARE stmt2 FROM
'SELECT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
          OVER (PARTITION BY a) AS s
   FROM t GROUP BY a WITH ROLLUP ORDER BY a';
EXECUTE stmt2;
a	s
NULL	280
1	60
2	90
3	60
4	70
EXECUTE stmt2;
a	s
NULL	280
1	60
2	90
3	60
4	70
DEALLOCATE PREPARE stmt2;
CREATE VIEW vkeep_rollup_win AS
SELECT a, d,
SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a, d WITH ROLLUP;
SELECT * FROM vkeep_rollup_win ORDER BY a, d;
a	d	s
NULL	NULL	280
1	NULL	120
1	1	120
1	2	120
2	NULL	50
2	1	50
2	2	50
3	NULL	120
3	1	120
3	2	120
4	NULL	140
4	1	140
SHOW CREATE VIEW vkeep_rollup_win;
View	Create View	character_set_client	collation_connection
vkeep_rollup_win	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `vkeep_rollup_win` AS select `t`.`a` AS `a`,`t`.`d` AS `d`,sum(sum(`t`.`b`)) KEEP (DENSE_RANK FIRST ORDER BY max(`t`.`c`)) OVER (PARTITION BY `t`.`a` )  AS `s` from `t` group by `t`.`a`,`t`.`d` with rollup	utf8mb4	utf8mb4_0900_ai_ci
DROP VIEW vkeep_rollup_win;
CREATE TABLE tctas_win AS
SELECT a, d,
SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
OVER (PARTITION BY a) AS s
FROM t GROUP BY a, d WITH ROLLUP;
SELECT * FROM tctas_win ORDER BY a, d;
a	d	s
NULL	NULL	280
1	NULL	120
1	1	120
1	2	120
2	NULL	50
2	1	50
2	2	50
3	NULL	120
3	1	120
3	2	120
4	NULL	140
4	1	140
SHOW CREATE TABLE tctas_win;
Table	Create Table
tctas_win	CREATE TABLE `tctas_win` (
  `a` int DEFAULT NULL,
  `d` int DEFAULT NULL,
  `s` decimal(54,0) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE tctas_win;
# Oracle-style GROUP BY ROLLUP() remains a syntax error
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
FROM t GROUP BY ROLLUP(a);
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near '(a)' at line 2
# GROUPING() is not allowed in grouped KEEP arguments or ORDER BY
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY GROUPING(a)) AS s
FROM t GROUP BY a WITH ROLLUP;
ERROR HY000: Invalid use of group function
SELECT a, SUM(GROUPING(a)) KEEP (DENSE_RANK FIRST ORDER BY c) AS s
FROM t GROUP BY a WITH ROLLUP;
ERROR HY000: Invalid use of group function
# Ungrouped references in the window form keep the usual grouping error
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
OVER (PARTITION BY a) AS s
FROM t GROUP BY a WITH ROLLUP;
ERROR 42000: Expression #2 of SELECT list is not in GROUP BY clause and contains nonaggregated column 'test.t.b' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by
DROP TABLE t;
