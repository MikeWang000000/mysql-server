--echo #
--echo # Oracle-compatible KEEP (...) OVER () / OVER (PARTITION BY ...)
--echo #

CREATE TABLE t (a INT, b INT, c INT, d INT);
INSERT INTO t VALUES
  (1, 10, 1, 1),
  (1, 20, 2, 1),
  (1, 30, 2, 2),
  (2, 40, 1, 1),
  (2, 50, NULL, 2),
  (3, NULL, 3, 1),
  (3, 60, 3, 2),
  (4, 70, NULL, 1);

--echo # Basic window form: value is constant within each partition
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t ORDER BY a, b;

--echo # OVER () treats the whole result set as one partition
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER () AS s
FROM t ORDER BY a, b;

--echo # DENSE_RANK LAST
SELECT a, b, SUM(b) KEEP (DENSE_RANK LAST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t ORDER BY a, b;

--echo # All supported aggregate functions
SELECT a,
       MIN(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS mn,
       MAX(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS mx,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS sm,
       AVG(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a) AS av,
       COUNT(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a)
         AS cnt,
       COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (PARTITION BY a)
         AS cnt_star
FROM t ORDER BY a;

--echo # STDDEV/VARIANCE use MySQL (population) semantics in window form
SELECT a, b,
       STDDEV(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS sd_first,
       STDDEV(b) KEEP (DENSE_RANK LAST ORDER BY c)
         OVER (PARTITION BY a) AS sd_last
FROM t ORDER BY a, b;

--echo # MySQL population semantics: one value -> 0, none -> NULL
CREATE TABLE tv (a INT, b INT, c INT);
INSERT INTO tv VALUES
  (1, NULL, 1), (1, 10, 2),
  (2, 10, 1), (2, 20, 2),
  (3, 10, 1), (3, 20, 1), (3, 40, 2);
SELECT a,
       STDDEV(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS sd,
       VARIANCE(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS var
FROM tv ORDER BY a;
DROP TABLE tv;

--echo # Multiple partition columns
SELECT a, d, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a, d) AS s
FROM t ORDER BY a, d, b;

--echo # STRING/DECIMAL/DATE result types through the window path
CREATE TABLE tm (g INT, s VARCHAR(10) COLLATE utf8mb4_bin,
                 x DECIMAL(10, 2), d DATE, v INT);
INSERT INTO tm VALUES
  (1, 'b', 2.50, '2020-01-03', 20),
  (1, 'a', 1.25, '2020-01-01', 10),
  (1, 'c', 3.75, '2020-01-02', 30);
SELECT g,
       MIN(s) KEEP (DENSE_RANK FIRST ORDER BY v)
         OVER (PARTITION BY g) AS ms,
       AVG(x) KEEP (DENSE_RANK FIRST ORDER BY v)
         OVER (PARTITION BY g) AS ax,
       MIN(d) KEEP (DENSE_RANK FIRST ORDER BY v)
         OVER (PARTITION BY g) AS md
FROM tm ORDER BY g, v;
DROP TABLE tm;

--echo # JSON result type through the window path
CREATE TABLE tj (g INT, j JSON, v INT);
INSERT INTO tj VALUES
  (1, '{"k": 2}', 20), (1, '{"k": 1}', 10), (1, '{"k": 3}', 30);
SELECT g, MIN(j) KEEP (DENSE_RANK FIRST ORDER BY v)
         OVER (PARTITION BY g) AS mj_first,
       MAX(j) KEEP (DENSE_RANK LAST ORDER BY v)
         OVER (PARTITION BY g) AS mj_last
FROM tj;
DROP TABLE tj;

--echo # Constant ORDER BY expressions: all rows in a partition are peers
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY 1) OVER (PARTITION BY a) AS s
FROM t ORDER BY a;

SELECT a, COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY NULL)
         OVER (PARTITION BY a) AS c
FROM t ORDER BY a;

--echo # Single-row partition
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t WHERE a = 4;

--echo # Input rows not sorted by partition
CREATE TABLE ts (a INT, b INT, c INT);
INSERT INTO ts VALUES
  (2, 50, NULL), (1, 20, 2), (3, 60, 3), (1, 10, 1),
  (2, 40, 1), (3, NULL, 3), (1, 30, 2), (4, 70, NULL);
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM ts ORDER BY a, b;
DROP TABLE ts;

--echo # Multiple ORDER BY columns, DESC and explicit NULL placement
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c, d DESC)
         OVER (PARTITION BY a) AS s1,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c DESC NULLS LAST)
         OVER (PARTITION BY a) AS s2
FROM t ORDER BY a;

--echo # Multiple KEEPs in one SELECT list: different FIRST/LAST/NULLS
SELECT a, b,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS FIRST)
         OVER (PARTITION BY a) AS f_nf,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c NULLS LAST)
         OVER (PARTITION BY a) AS f_nl,
       SUM(b) KEEP (DENSE_RANK LAST ORDER BY c NULLS FIRST)
         OVER (PARTITION BY a) AS l_nf,
       SUM(b) KEEP (DENSE_RANK LAST ORDER BY c NULLS LAST)
         OVER (PARTITION BY a) AS l_nl,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY d DESC, c ASC NULLS FIRST)
         OVER (PARTITION BY a) AS f_dc,
       SUM(b) KEEP (DENSE_RANK LAST ORDER BY d ASC, c DESC NULLS LAST)
         OVER (PARTITION BY a) AS l_dc
FROM t ORDER BY a, b;

--echo # Two different window definitions in one query
SELECT a, d, b,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s1,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a, d) AS s2
FROM t ORDER BY a, d, b;

--echo # KEEP window after another window function
SELECT a, b,
       ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) AS rn,
       SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t ORDER BY a, b;

--echo # Empty input
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER () AS s
FROM t WHERE 1 = 0;

--echo # KEEP window expression inside another expression
SELECT a, ROUND(AVG(b) KEEP (DENSE_RANK FIRST ORDER BY c)
                OVER (PARTITION BY a), 2) + 1 AS av
FROM t ORDER BY a;

--echo # Query-level ORDER BY / LIMIT
SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t ORDER BY s DESC, a, b LIMIT 5;

--echo # KEEP window function used only in ORDER BY and with DISTINCT
SELECT DISTINCT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t ORDER BY a;

--echo # Derived table, scalar subquery, UNION ALL
SELECT * FROM (
  SELECT a, MAX(b) KEEP (DENSE_RANK FIRST ORDER BY c)
           OVER (PARTITION BY a) AS x
  FROM t
) dt ORDER BY a;

SELECT (SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER ()
        FROM t WHERE a = 1 LIMIT 1) AS s;

SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t WHERE a <= 2
UNION ALL
SELECT a, SUM(b) KEEP (DENSE_RANK LAST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t WHERE a >= 3
ORDER BY a, s;

--echo # Prepared statement, executed twice
PREPARE stmt FROM
  'SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
          OVER (PARTITION BY a) AS s
   FROM t ORDER BY a, b';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

--echo # Correlated subquery with a window KEEP, executed once per outer row
CREATE TABLE t2 (a INT);
INSERT INTO t2 VALUES (1), (2), (3), (4);
SELECT t2.a,
       (SELECT SUM(t.b) KEEP (DENSE_RANK FIRST ORDER BY t.c) OVER ()
        FROM t WHERE t.a = t2.a LIMIT 1) AS s
FROM t2 ORDER BY t2.a;
DROP TABLE t2;

--echo # View definition round-trip (print())
CREATE VIEW vkeep_over AS
  SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
           OVER (PARTITION BY a) AS s
  FROM t;
SELECT * FROM vkeep_over ORDER BY a, b;
SHOW CREATE VIEW vkeep_over;
DROP VIEW vkeep_over;

--echo # CREATE TABLE ... SELECT
CREATE TABLE tctas AS
  SELECT a, b, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
           OVER (PARTITION BY a) AS s
  FROM t;
SELECT * FROM tctas ORDER BY a, b;
SHOW CREATE TABLE tctas;
DROP TABLE tctas;

--echo # Same-level GROUP BY: grouped columns are legal
SELECT a, b, c, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t GROUP BY a, b, c ORDER BY a, b, c;

--echo # Same-level GROUP BY: aggregate arguments are legal
SELECT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
         OVER (PARTITION BY a) AS s
FROM t GROUP BY a ORDER BY a;

SELECT SQL_BIG_RESULT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
         OVER (PARTITION BY a) AS s
FROM t GROUP BY a ORDER BY a;

SELECT a, SUM(a) KEEP (DENSE_RANK FIRST ORDER BY a)
         OVER (PARTITION BY a) AS s
FROM t GROUP BY a ORDER BY a;

SELECT a, SUM(a) KEEP (DENSE_RANK FIRST ORDER BY a) OVER () AS s
FROM t GROUP BY a ORDER BY a;

PREPARE stmt2 FROM
  'SELECT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
          OVER (PARTITION BY a) AS s
   FROM t GROUP BY a ORDER BY a';
EXECUTE stmt2;
EXECUTE stmt2;
DEALLOCATE PREPARE stmt2;

--echo # Same-level GROUP BY: ungrouped references are rejected like MySQL
--error ER_WRONG_FIELD_WITH_GROUP
SELECT a, SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t GROUP BY a;

--error ER_WRONG_FIELD_WITH_GROUP
SELECT a, COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY c)
         OVER (PARTITION BY a) AS s
FROM t GROUP BY a;

--echo # GROUP BY ... WITH ROLLUP, using aggregate arguments
SELECT a, SUM(SUM(b)) KEEP (DENSE_RANK FIRST ORDER BY MAX(c))
         OVER (PARTITION BY a) AS s
FROM t GROUP BY a WITH ROLLUP ORDER BY a;

--echo # Unsupported window forms must be rejected
--error ER_PARSE_ERROR
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
       OVER (ORDER BY c) FROM t;

--error ER_PARSE_ERROR
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
       OVER (PARTITION BY a ORDER BY c) FROM t;

--error ER_PARSE_ERROR
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
       OVER (ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t;

--error ER_PARSE_ERROR
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
       OVER (RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t;

--error ER_PARSE_ERROR
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c)
       OVER (GROUPS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t;

--error ER_PARSE_ERROR
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER w
FROM t WINDOW w AS (PARTITION BY a);

--error ER_PARSE_ERROR
SELECT SUM(b) KEEP (DENSE_RANK FIRST ORDER BY c) OVER (w PARTITION BY a)
FROM t WINDOW w AS ();

--error ER_PARSE_ERROR
SELECT SUM(DISTINCT b) KEEP (DENSE_RANK FIRST ORDER BY c)
       OVER (PARTITION BY a) FROM t;

--error ER_PARSE_ERROR
SELECT MEDIAN(b) KEEP (DENSE_RANK FIRST ORDER BY c)
       OVER (PARTITION BY a) FROM t;

DROP TABLE t;
