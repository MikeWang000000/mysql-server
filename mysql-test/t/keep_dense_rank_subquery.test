--echo #
--echo # KEEP (DENSE_RANK ...) with subqueries in various positions
--echo #

CREATE TABLE tk (g INT, id INT, v INT, o INT);
INSERT INTO tk VALUES
  (1, 1, 10, 2),
  (1, 2, 20, 1),
  (1, 3, 30, 1),
  (2, 4, 40, 2),
  (2, 5, 50, NULL),
  (3, 6, NULL, 3);

CREATE TABLE tlook (id INT, x INT);
INSERT INTO tlook VALUES
  (1, 100), (2, 200), (3, 300), (4, 400), (5, NULL), (6, 600);

CREATE TABLE tg (g INT);
INSERT INTO tg VALUES (1), (2), (3);

--echo # Subquery in the wrapped aggregate's argument
SELECT g,
       SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
FROM tk GROUP BY g ORDER BY g;

SELECT g,
       SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK LAST ORDER BY o NULLS FIRST) AS s
FROM tk GROUP BY g ORDER BY g;

--echo # Subquery argument with all supported aggregates
SELECT MIN((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS mn,
       MAX((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS mx,
       ROUND(AVG((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST), 2) AS av,
       COUNT((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS cnt,
       STDDEV((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) = 50 AS sd_ok,
       VARIANCE((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) = 2500 AS var_ok
FROM tk;

--echo # Subquery in KEEP's ORDER BY
SELECT g,
       SUM(v) KEEP (DENSE_RANK FIRST ORDER BY
         (SELECT x FROM tlook WHERE tlook.id = tk.id) NULLS LAST) AS s
FROM tk GROUP BY g ORDER BY g;

SELECT g,
       SUM(v) KEEP (DENSE_RANK LAST ORDER BY
         (SELECT x FROM tlook WHERE tlook.id = tk.id) NULLS FIRST) AS s
FROM tk GROUP BY g ORDER BY g;

--echo # Subqueries in both the argument and ORDER BY
SELECT g,
       SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY
           (SELECT x FROM tlook WHERE tlook.id = tk.id) DESC) AS s
FROM tk GROUP BY g ORDER BY g;

--echo # EXISTS subquery in KEEP's ORDER BY
SELECT g,
       SUM(v) KEEP (DENSE_RANK FIRST ORDER BY
         EXISTS (SELECT 1 FROM tlook
                 WHERE tlook.id = tk.id AND tlook.x > 250)) AS s
FROM tk GROUP BY g ORDER BY g;

--echo # Subquery in WHERE
SELECT g, SUM(v) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
FROM tk
WHERE id IN (SELECT id FROM tlook WHERE x >= 300)
GROUP BY g ORDER BY g;

--echo # Subquery in HAVING
SELECT g, SUM(v) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
FROM tk GROUP BY g
HAVING SUM(v) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST)
       > (SELECT MIN(v) FROM tk)
ORDER BY g;

--echo # Subquery in query-level ORDER BY
SELECT g, SUM(v) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
FROM tk GROUP BY g
ORDER BY (SELECT x FROM tlook WHERE tlook.id = g) DESC;

--echo # KEEP in a correlated scalar subquery
SELECT tg.g,
       (SELECT SUM(v) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST)
        FROM tk WHERE tk.g = tg.g) AS s
FROM tg ORDER BY tg.g;

--echo # KEEP in an IN subquery
SELECT g FROM tg
WHERE g IN (
  SELECT g FROM tk GROUP BY g
  HAVING SUM(v) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) > 40
) ORDER BY g;

--echo # KEEP in an EXISTS subquery
SELECT g FROM tg
WHERE EXISTS (
  SELECT 1 FROM tk WHERE tk.g = tg.g GROUP BY tk.g
  HAVING COUNT(*) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) >= 2
) ORDER BY g;

--echo # Outer references in KEEP's argument and ORDER BY
SELECT tg.g,
       (SELECT SUM(tk.v + tg.g)
               KEEP (DENSE_RANK FIRST ORDER BY tk.o + tg.g NULLS LAST)
        FROM tk WHERE tk.g = tg.g) AS s
FROM tg ORDER BY tg.g;

SELECT tg.g,
       (SELECT SUM(tk.v)
               KEEP (DENSE_RANK FIRST ORDER BY tk.o + tg.g NULLS LAST)
        FROM tk WHERE tk.g = tg.g) AS s
FROM tg ORDER BY tg.g;

--echo # Derived table containing subqueries inside KEEP
SELECT * FROM (
  SELECT g, SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
              KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
  FROM tk GROUP BY g
) dt ORDER BY g;

--echo # CTE containing subqueries inside KEEP
WITH cte AS (
  SELECT g, SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
              KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
  FROM tk GROUP BY g
)
SELECT * FROM cte ORDER BY g;

--echo # View definition round-trip with a subquery inside KEEP
CREATE VIEW vkeep_sub AS
  SELECT g, SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
              KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
  FROM tk GROUP BY g;
SELECT * FROM vkeep_sub ORDER BY g;
SHOW CREATE VIEW vkeep_sub;
DROP VIEW vkeep_sub;

--echo # Prepared statement containing a subquery inside KEEP
PREPARE stmt FROM
  'SELECT g, SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
          KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
   FROM tk GROUP BY g ORDER BY g';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

--echo # Window KEEP: subquery in the wrapped aggregate's argument
SELECT id, g,
       SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST)
         OVER (PARTITION BY g) AS s
FROM tk ORDER BY id;

--echo # Window KEEP: subquery in KEEP's ORDER BY
SELECT id, g,
       SUM(v) KEEP (DENSE_RANK FIRST ORDER BY
         (SELECT x FROM tlook WHERE tlook.id = tk.id) NULLS LAST)
         OVER (PARTITION BY g) AS s
FROM tk ORDER BY id;

--echo # Window KEEP: subquery in PARTITION BY
SELECT id, g,
       SUM(v) KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST)
         OVER (PARTITION BY (SELECT x FROM tlook WHERE tlook.id = tk.id)) AS s
FROM tk ORDER BY id;

--echo # ROLLUP with a subquery inside KEEP
SELECT g, SUM((SELECT x FROM tlook WHERE tlook.id = tk.id))
         KEEP (DENSE_RANK FIRST ORDER BY o NULLS LAST) AS s
FROM tk GROUP BY g WITH ROLLUP ORDER BY g;

SELECT g, SUM(v) KEEP (DENSE_RANK FIRST ORDER BY
         (SELECT x FROM tlook WHERE tlook.id = tk.id) NULLS LAST) AS s
FROM tk GROUP BY g WITH ROLLUP ORDER BY g;

--echo # Multi-row subquery in KEEP's argument must fail
--error ER_SUBQUERY_NO_1_ROW
SELECT SUM((SELECT x FROM tlook)) KEEP (DENSE_RANK FIRST ORDER BY o)
FROM tk;

--echo # Multi-row subquery in KEEP's ORDER BY must fail
--error ER_SUBQUERY_NO_1_ROW
SELECT SUM(v) KEEP (DENSE_RANK FIRST ORDER BY (SELECT x FROM tlook))
FROM tk;

DROP TABLE tk, tlook, tg;
